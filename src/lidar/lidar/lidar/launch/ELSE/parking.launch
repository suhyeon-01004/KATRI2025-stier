<!--FOR TRACK RACING & RECORDING-->
<launch>
    
    <include file="$(find velodyne_pointcloud)/launch/VLP16_points.launch" />

    <node pkg="object_detector" type="object_detector" name="object_detector" output="screen"/>
    <node pkg='final' type="parking.py" name="parking" />

    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find lidar)/rviz/final.rviz" />
