<launch>
  <!-- 플래그 -->
  <arg name="run_local_ekf"   default="true"/>
  <arg name="run_global_ekf"  default="true"/>
  <arg name="run_wheel_odom"  default="true"/>
  <arg name="run_utm_bridge"  default="true"/>

  <!-- wheel_odom: 네임스페이스 안에서 퍼블리시 토픽을 전역으로 노출 -->
  <group ns="wheel_odom" if="$(arg run_wheel_odom)">
    <!-- wheel_odom 노드가 기본으로 'wheel/odom'에 퍼블리시하므로,
         이를 전역 '/wheel/odom'으로 리매핑 -->
    <remap from="wheel/odom" to="/wheel/odom"/>
    <include file="$(find stier_localization)/launch/wheel_odom.launch"/>
  </group>

  <!-- ekf_local: 파라미터상 상대 토픽명(imu/data, wheel/odom)을
       실제 전역 토픽(/imu/data, /wheel/odom)로 리매핑 -->
  <group ns="ekf_local" if="$(arg run_local_ekf)">
    <remap from="imu/data"   to="/imu/data"/>
    <remap from="wheel/odom" to="/wheel/odom"/>
    <include file="$(find stier_localization)/launch/ekf_local.launch"/>
  </group>

  <!-- UTM Bridge (전역 프레임/토픽을 쓰면 리매핑 필요 없음) -->
  <group ns="utm_bridge" if="$(arg run_utm_bridge)">
    <include file="$(find stier_localization)/launch/utm_navpvt_to_odom.launch"/>
  </group>

  <!-- ekf_global: 이미 /imu/data, /odometry/gps 같은 전역 토픽을 쓰고 있으니 그대로 -->
  <group ns="ekf_global" if="$(arg run_global_ekf)">
    <include file="$(find stier_localization)/launch/ekf_global.launch"/>
  </group>
</launch>

