<launch>
    <!-- 파라미터 설정 -->
    <param name="rddf" type="string" value="2025-8-2_12-35_semi.txt" />
    <param name="ld" type="double" value="1.5" />
    <param name="speed" type="double" value="5.0" />
    <param name="section_fix" type="int" value="1" />
    
    <!-- rosrun stier pp 실행 -->
    <node pkg="stier" type="pp" name="pp_node" output="screen" />
</launch>
