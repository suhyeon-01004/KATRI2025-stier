<launch>
  <node pkg="rviz" type="rviz" name="rviz" args="-d /home/stier/catkin_ws/src/control/stier/rviz/final.rviz" output="screen" />
  
  <!-- 컨트롤 -->
  <node name="vi" pkg="stier" type="vi" output="screen" respawn="true" launch-prefix="xterm -e" />
  <node name="pp" pkg="stier" type="pp" output="screen" respawn="true" launch-prefix="xterm -e" /> 


  <!-- 라이다 항상 키는거 -->
  <node name="object_detector" pkg="object_detector" type="object_detector" output="screen" respawn="true" launch-prefix="xterm -e" />

  <node name="detect_lane" pkg="recognition" type="detect_lane.py" output="screen" respawn="true" launch-prefix="xterm -e" />

  <node name="pure_pursuit_lidar" pkg="lidar" type="pure_pursuit_lidar.py" output="screen" respawn="true" launch-prefix="xterm -e" />


  <!-- 차선 키는거 -->
  <node name="lane_control" pkg="mission" type="lane_control.py" output="screen" respawn="true" args="--section" launch-prefix="xterm -e" />
  
  <!-- 인식 -->
  <node name="traffic_light" pkg="recognition" type="traffic_light.py" output="screen" respawn="true" launch-prefix="xterm -e" />
  <node name="stop_line" pkg="recognition" type="stop_line.py" output="screen" respawn="true" launch-prefix="xterm -e" />

  <!-- 미션 -->
  <node name="avoid_small" pkg="mission" type="avoid_small.py" output="screen" respawn="true" args="--section" launch-prefix="xterm -e" >
  </node>
  <node name="avoid_car" pkg="mission" type="avoid_car.py" output="screen" respawn="true" args="--section" launch-prefix="xterm -e" />
  <node name="deliveryA" pkg="mission" type="deliveryA.py" output="screen" respawn="true" args="--section" launch-prefix="xterm -e" />
  <node name="deliveryB" pkg="mission" type="deliveryB.py" output="screen" respawn="true" args="--section" launch-prefix="xterm -e" />
  
  <node name="parking" pkg="mission" type="parking.py" output="screen" respawn="true" launch-prefix="xterm -e" />
  
  

</launch>
