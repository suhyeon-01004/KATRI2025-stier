<launch>
  <node name="usb_cam1" pkg="usb_cam" type="usb_cam_node" output="screen">
    <param name="video_device" value="/dev/video0" />  <!-- 필요 시 /dev/video1로 바꿔 테스트 -->
    <param name="image_width"  value="1280" />
    <param name="image_height" value="720" />
    <param name="pixel_format" value="yuyv" />         <!-- 안되면 mjpeg로 교체 -->
    <param name="framerate"    value="30" />
    <param name="camera_name"  value="kiyo_pro_front" />
  </node>
</launch>

