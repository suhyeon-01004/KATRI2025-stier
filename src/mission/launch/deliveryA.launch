<launch>

<node pkg="rviz" type="rviz" name="rviz" args="-d /home/stier/catkin_ws/src/mission/rviz/deliveryA.rviz" output="screen" />

  <node name="deliveryA" pkg="mission" type="deliveryA.py" output="screen" respawn="true" launch-prefix="xterm -e" args="--section"/> 
  
  <node name="lane_control" pkg="mission" type="lane_control.py" output="screen" respawn="true" launch-prefix="xterm -e" args="--section"/> 
  
  <node name="object_detector" pkg="object_detector" type="object_detector" output="screen" respawn="true" />
  
  <node name="lidar_pp" pkg="lidar" type="pure_pursuit_final.py" output="screen" respawn="true" launch-prefix="xterm -e"/>
  
  <node name="pp_test" pkg="stier" type="pp_test" output="screen" respawn="true" launch-prefix="xterm -e" />
  
  <node name="detect_lane" pkg="recognition" type="detect_lane.py" output="screen" respawn="true" />
  
</launch>
